# ---- 构建产物 ----
build/
dist/
dist*/
*.spec
*.exe
*.dll
*.pdb

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.eggs/

# ---- 临时/工作目录 ----
tmp/
temp/
out/
shots/
tests/
_probe/
_MEI*/

# ---- 游戏资源（版权属 KONAMI，绝不入库）----
# 但 release/ 下是我们自己的构建产物，作为自更新下载源，需要入库
!release/*.exe
!VERSION
# tools/assets/ffmpeg.exe（73.8 MB）也刻意不入库——二进制走 Release 分发，
# 免得 clone 仓库要拖 74 MB。自行构建时按 README「ffmpeg 怎么放」准备。
*.ifs
*.bin
*.pac
*.eve
*.mc
*.mcz
*.mcz
*.ogg
*.mp3
*.wav
*.png
*.jpg
*.img
*.tdxt

# ---- 私有配置与凭据 ----
ub_store_data/
config.json
credentials.json
*.key
*.pem
id_ed25519*
known_hosts

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
